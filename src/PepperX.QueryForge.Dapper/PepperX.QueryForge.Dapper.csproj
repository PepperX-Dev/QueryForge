<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	<PackageId>PepperX.QueryForge.Dapper</PackageId>
	<Version>2.0.0</Version>
	<Authors>Amir Hossein Morady Pour</Authors>
	<Description>High-performance execution provider for the PepperX.QueryForge core library. It compiles abstract query models into parameterized SQL and executes them with Dapper against SQL Server, PostgreSQL, MySQL/MariaDB and Oracle, handling hierarchical grouping, complex filtering, and function/procedure integration. No schema permissions or deployed database objects required.</Description>
	<PackageTags>dapper;sql-server;postgresql;mysql;mariadb;oracle;ado-net;execution-provider;dynamic-sql;csharp;dotnet;micro-orm;sql</PackageTags>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/PepperX-Dev/QueryForge/tree/main/src/PepperX.QueryForge.Dapper</RepositoryUrl>
	<PackageIcon>icon.png</PackageIcon>

	<IsPackable>true</IsPackable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>

	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\PepperX.QueryForge\PepperX.QueryForge.csproj" />
	  
    <InternalsVisibleTo Include="PepperX.QueryForge.Dapper.Tests" />

	<None Include="README.md" Pack="true" PackagePath="\" />
	<None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
